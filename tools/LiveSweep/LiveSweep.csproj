<Project Sdk="Microsoft.NET.Sdk">

  <!-- Calls every SDK method once against a running API (see Program.cs for the command line). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LifeAstroApi.LiveSweep</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LifeAstroApi/LifeAstroApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tests/Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
